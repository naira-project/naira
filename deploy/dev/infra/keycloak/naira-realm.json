{
  "realm": "naira",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "roles": {
    "realm": [
      { "name": "ai-engineer", "description": "AI Engineer" },
      { "name": "application-engineer", "description": "Application Engineer"}
    ]
  },
  "clients": [
    {
      "clientId": "naira-portal",
      "enabled": true,
      "publicClient": false,
      "secret": "__KEYCLOAK_CLIENT_SECRET__",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "realm-roles-to-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "email": "test@test.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "testpass", "temporary": false }
      ],
      "realmRoles": ["ai-engineer", "offline_access", "uma_authorization"]
    },
    {
      "username": "testuser-appeng",
      "enabled": true,
      "email": "test-appeng@test.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "ApplicationEngineer",
      "credentials": [
        { "type": "password", "value": "testpass", "temporary": false }
      ],
      "realmRoles": ["application-engineer", "offline_access", "uma_authorization"]
    }
  ]
}
