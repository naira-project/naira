{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "prerelease": true,
      "versioning": "prerelease",
      "extra-files": [
        {
          "type": "yaml",
          "path": "deploy/charts/naira/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "deploy/charts/naira/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ],
      "prerelease-type": "rc",
      "skip-github-release": true
    }
  }
}
