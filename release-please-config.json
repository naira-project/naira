{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "prerelease": false,
      "versioning": "prerelease",
      "release-as": "0.1.1",
      "extra-files": [
        {"type": "yaml", "path": "deploy/charts/naira/Chart.yaml", "jsonpath": "$.version"},
        {"type": "yaml", "path": "deploy/charts/naira/Chart.yaml", "jsonpath": "$.appVersion"}
      ]
    }
  }
}
