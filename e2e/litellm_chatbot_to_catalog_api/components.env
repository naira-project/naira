# Sourced by scripts/create-environment.sh --scenario litellm_chatbot_to_catalog_api
#
# catalog and keycloak are always deployed by the script (every scenario
# needs the thing under test, and auth to reach it) — this file only lists
# the optional pieces from e2e/components/ this particular scenario needs.
#
# COMPONENTS: standalone components/*.yaml to apply, space-separated. Pick
# from: litellm mlflow llamacpp openmetadata postgres ui portal chatbot1
# postgres is here for litellm's virtual-key management (see litellm.yaml) —
# the seed step uses it to mint chatbot1 a key scoped to one model. Order
# matters: components are applied in this order, and litellm needs postgres
# reachable at boot (its DB connection isn't retried indefinitely).
COMPONENTS="postgres litellm chatbot1"

# PLUGINS: catalog init-container sidecars to run, space-separated. Pick
# from: litellm mlflow depl-calls-svc depl-uses-litellm fluxcd openmetadata
PLUGINS="litellm depl-uses-litellm"
